{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "android-to-harmony.behavior-source-closure.v1",
  "type": "object",
  "required": ["schema_version", "census_sha256", "inventory_sha256", "bindings"],
  "properties": {
    "schema_version": {"const": "behavior-source-closure.v1"},
    "census_sha256": {"$ref": "#/$defs/hash"},
    "inventory_sha256": {"$ref": "#/$defs/hash"},
    "bindings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["record_ids", "scenario_ids"],
        "oneOf": [
          {"required": ["obligation_id"], "not": {"required": ["obligation_ids"]}},
          {"required": ["obligation_ids"], "not": {"required": ["obligation_id"]}}
        ],
        "properties": {
          "obligation_id": {"$ref": "#/$defs/hash"},
          "obligation_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
                             "items": {"$ref": "#/$defs/hash"}},
          "record_ids": {"$ref": "#/$defs/ids"},
          "scenario_ids": {"$ref": "#/$defs/ids"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}},
    "scope": {
      "type": "object", "required": ["schema_version", "id", "kind", "source_revision", "entry_paths"],
      "properties": {
        "schema_version": {"const": "behavior-source-scope.v1"},
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["page", "flow", "application"]},
        "source_revision": {"type": "string", "minLength": 1},
        "entry_paths": {"$ref": "#/$defs/ids"},
        "entry_symbols": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ids"}},
        "definition_boundaries": {
          "type": "array", "items": {
            "type": "object",
            "required": ["path", "symbol", "behavior_ranges", "context_reason", "resolved_dependencies", "unresolved"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "symbol": {"type": "string", "minLength": 1},
              "definition_line": {"type": "integer", "minimum": 1},
              "behavior_ranges": {"type": "array", "items": {
                "type": "object", "required": ["start_line", "end_line"],
                "properties": {"start_line": {"type": "integer", "minimum": 1},
                               "end_line": {"type": "integer", "minimum": 1}}
              }},
              "context_reason": {"type": "string", "minLength": 1},
              "resolved_dependencies": {"type": "array", "items": {
                "type": "object", "required": ["path", "symbol"],
                "properties": {"path": {"type": "string", "minLength": 1},
                               "symbol": {"type": "string", "minLength": 1},
                               "definition_line": {"type": "integer", "minimum": 1}}
              }},
              "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["schema_version", "verdict", "reviewer", "scope_sha256", "census_sha256",
                   "contract_sha256", "unresolved", "expectations", "dependency_edges", "external_dependencies"],
      "properties": {
        "schema_version": {"const": "behavior-source-review.v1"},
        "verdict": {"enum": ["pass", "fail", "pending"]},
        "reviewer": {"type": "string", "minLength": 1},
        "scope_sha256": {"$ref": "#/$defs/hash"},
        "census_sha256": {"$ref": "#/$defs/hash"},
        "contract_sha256": {"$ref": "#/$defs/hash"},
        "unresolved": {"type": "array"},
        "dependency_edges": {"type": "array"},
        "external_dependencies": {"type": "array"},
        "expectations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "summary", "obligation_ids", "record_ids", "scenario_ids"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "summary": {"type": "string", "minLength": 1},
              "obligation_ids": {"$ref": "#/$defs/ids"},
              "record_ids": {"$ref": "#/$defs/ids"},
              "scenario_ids": {"$ref": "#/$defs/ids"}
            }
          }
        }
      }
    }
  }
}
