{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavior-source-snapshot.v1",
  "type": "object",
  "required": ["schema_version", "source_revision", "text_files", "text_file_sha256"],
  "properties": {
    "schema_version": {"const": "behavior-source-snapshot.v1"},
    "source_revision": {"type": "string", "minLength": 1},
    "text_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "text_file_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "blocked_files": {"type": "array"}
  }
}
